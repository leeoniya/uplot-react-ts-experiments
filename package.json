{
  "name": "react-bun-typescript-starter",
  "version": "0.1.0",
  "description": "Starter kit for Bun, React, and Typescript (bundler, dev server with HMR, and test runner all provided by Bun).",
  "keywords": [
    "react",
    "bun",
    "typescript",
    "hmr",
    "starter",
    "boilerplate"
  ],
  "author": "Viktor Persson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikpe/react-webpack-typescript-starter.git"
  },
  "bugs": {
    "url": "https://github.com/vikpe/react-webpack-typescript-starter/issues"
  },
  "homepage": "https://github.com/vikpe/react-webpack-typescript-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "BUN_PORT=8080 bun ./index.html",
    "start": "BUN_PORT=8080 bun ./index.html",
    "build": "rm -rf dist && bun build ./index.html --outdir dist --sourcemap=linked",
    "start-prod": "bun run build && bun run serve.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "uplot": "^1.6.19"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.0.3",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.9.3"
  }
}
