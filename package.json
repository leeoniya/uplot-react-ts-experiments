{
  "name": "react-bun-typescript-starter",
  "version": "0.1.0",
  "description": "Starter kit for Bun, React, and Typescript (bundler, dev server with HMR, and test runner all provided by Bun).",
  "keywords": [
    "react",
    "bun",
    "typescript",
    "hmr",
    "starter",
    "boilerplate"
  ],
  "author": "Viktor Persson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikpe/react-webpack-typescript-starter.git"
  },
  "bugs": {
    "url": "https://github.com/vikpe/react-webpack-typescript-starter/issues"
  },
  "homepage": "https://github.com/vikpe/react-webpack-typescript-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run serve.ts",
    "start": "NODE_ENV=production bun run serve.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
